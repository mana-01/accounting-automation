# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Google API Configuration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# または credentials.json ファイルのパス
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Google Spreadsheet ID (URLから取得: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Google Drive Folder ID (請求書保存用フォルダ)
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# 税理士共有用 Google Drive フォルダ ID
ACCOUNTANT_CARD_FOLDER_ID=your-accountant-card-folder-id
ACCOUNTANT_BANK_FOLDER_ID=your-accountant-bank-folder-id

# Gmail Configuration
GMAIL_USER_EMAIL=your-email@gmail.com

# Slack通知チャンネル
SLACK_NOTIFICATION_CHANNEL=#accounting

# Gemini API (PDF請求書の構造化データ抽出用)
GEMINI_API_KEY=your-gemini-api-key

# アプリ設定
PORT=3000
DEBUG=false
