{
  "version": 2,
  "functions": {
    "api/slack.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/hellotrunk",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/fetch-invoices",
      "schedule": "30 0 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/slack",
      "destination": "/api/slack"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/slack"
    },
    {
      "source": "/(.*)",
      "destination": "/api/slack"
    }
  ]
}
