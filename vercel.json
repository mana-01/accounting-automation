{
  "version": 2,
  "functions": {
    "api/slack.py": {
      "runtime": "@vercel/python",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/slack",
      "destination": "/api/slack.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/slack.py"
    }
  ]
}

