{
  "version": 2,
  "builds": [
    {
      "src": "api/slack.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/slack",
      "dest": "/api/slack.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/slack.py"
    }
  ]
}
